Provinces:
LOAD
    code as CodeProvince,
    libelle as Province,
    type as TypeProvince,
    capitale as Capitale
FROM [lib://DataFiles/provinces.csv]
(txt, utf8, embedded labels, delimiter is ';', msq);

EPA:
LOAD
    [PÉRIODE DE RÉFÉRENCE] as Annee,
    [GÉO] as Province,
    [Caractéristiques de la population active] as Indicateur,
    [Classification nationale des professions (CNP)] as Profession,
    Genre,
    [UNITÉ DE MESURE] as Unite,
    VALEUR as Valeur,
    STATUS as Statut
FROM [lib://DataFiles/population.csv]
(txt, utf8, embedded labels, delimiter is ';', msq);

EIMT:
LOAD
    2021 as Annee,
    'T4' as Trimestre,
    A as ProvinceBrute,
    B as Volet,
    C as Employeur,
    D as Adresse,
    E as ProfessionBrute,
    G as EIMTApprouvees,
    H as PostesApprouves
FROM [lib://DataFiles/tfwp_2021q4_pos_fr.xlsx]
(ooxml, no labels, header is 2 lines, table is Positive_FR);

